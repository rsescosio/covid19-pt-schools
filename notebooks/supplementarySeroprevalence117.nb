 RowBox[{
  RowBox[{
   RowBox[{"formatItem", "[", 
    RowBox[{"a_", ",", "rowIndex_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "val", ",", "minInt", ",", "maxInt", ",", "isHospRow", ",", 
       "formatNum"}], "}"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "[", "\"\<Value\>\"", "]"}], ">", "1000000"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Date", " ", "formatting", " ", "remains", " ", "untouched"}],
         "*)"}], 
       RowBox[{
        RowBox[{"DateString", "[", 
         RowBox[{
          RowBox[{"a", "[", "\"\<Value\>\"", "]"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<MonthNameShort\>\"", ",", "\"\< \>\"", 
            ",", "\"\<Day\>\""}], "}"}]}], "]"}], "<>", "\"\< (\>\"", "<>", 
        RowBox[{"DateString", "[", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"a", "[", "\"\<Interval\>\"", "]"}], "]"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<MonthNameShort\>\"", ",", "\"\< \>\"", 
            ",", "\"\<Day\>\""}], "}"}]}], "]"}], "<>", "\"\< - \>\"", "<>", 
        RowBox[{"DateString", "[", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"a", "[", "\"\<Interval\>\"", "]"}], "]"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<MonthNameShort\>\"", ",", "\"\< \>\"", 
            ",", "\"\<Day\>\""}], "}"}]}], "]"}], "<>", "\"\<)\>\""}], ",", 
       RowBox[{"(*", 
        RowBox[{"Floor", " ", "values", " ", "to", " ", "zero", " ", 
         RowBox[{"(", 
          RowBox[{"prevent", " ", "negatives"}], ")"}]}], "*)"}], 
       RowBox[{
        RowBox[{"val", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"a", "[", "\"\<Value\>\"", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minInt", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Min", "[", 
            RowBox[{"a", "[", "\"\<Interval\>\"", "]"}], "]"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"maxInt", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Max", "[", 
            RowBox[{"a", "[", "\"\<Interval\>\"", "]"}], "]"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Identify", " ", "if", " ", "the", " ", "current", " ", "item", " ", 
          "is", " ", "a", " ", "hospitalization", " ", "metric", " ", 
          RowBox[{"(", 
           RowBox[{"whole", " ", "numbers"}], ")"}]}], "*)"}], 
        RowBox[{"isHospRow", "=", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "4", ",", "5"}], "}"}], ",", 
           "rowIndex"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Helper", " ", "function", " ", "to", " ", "format", " ", "the", " ",
           "number", " ", "strings", " ", "accordingly"}], "*)"}], 
        RowBox[{
         RowBox[{"formatNum", "[", "x_", "]"}], ":=", 
         RowBox[{"If", "[", 
          RowBox[{"isHospRow", ",", 
           RowBox[{"ToString", "[", 
            RowBox[{"Round", "[", "x", "]"}], "]"}], ",", 
           RowBox[{"ToString", "[", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"x", ",", 
              RowBox[{"{", 
               RowBox[{"Infinity", ",", "2"}], "}"}]}], "]"}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Apply", " ", "the", " ", "formatting", " ", "and", " ", 
          "concatenate"}], "*)"}], 
        RowBox[{
         RowBox[{"formatNum", "[", "val", "]"}], "<>", "\"\< (\>\"", "<>", 
         RowBox[{"formatNum", "[", "minInt", "]"}], "<>", "\"\< - \>\"", "<>", 
         RowBox[{"formatNum", "[", "maxInt", "]"}], "<>", "\"\<)\>\""}]}]}], 
