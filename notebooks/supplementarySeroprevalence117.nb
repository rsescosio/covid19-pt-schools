Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getAroundMedian", "[", 
    RowBox[{"data_", ",", 
     RowBox[{"data2_", ":", "Automatic"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"actualData2", ",", "numData1", ",", "numData2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"actualData2", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"data2", "===", "Automatic"}], ",", "data", ",", "data2"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"numData1", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"data", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "_DateObject"}], "]"}], ",", 
         
         RowBox[{"AbsoluteTime", "/@", "data"}], ",", "data"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"numData2", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"actualData2", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "_DateObject"}], "]"}], ",", 
         
         RowBox[{"AbsoluteTime", "/@", "actualData2"}], ",", "actualData2"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Around", "[", 
       RowBox[{
        RowBox[{"Median", "[", "numData1", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Median", "[", "numData2", "]"}], "-", 
