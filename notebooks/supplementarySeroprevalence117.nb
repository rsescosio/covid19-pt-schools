               RowBox[{"-", "1"}]}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", "startDay", "-", "1"}], 
           "&"}], ",", "singleDataMatrix", ",", 
          RowBox[{"{", 
           RowBox[{"-", "2"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"allPeakDates", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
