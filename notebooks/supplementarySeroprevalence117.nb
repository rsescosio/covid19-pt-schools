       RowBox[{"{", 
        RowBox[{"Range", "[", 
         RowBox[{"1", ",", " ", "10"}], "]"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Simulating", " ", "a", " ", "negative", " ", "binomial", " ", 
