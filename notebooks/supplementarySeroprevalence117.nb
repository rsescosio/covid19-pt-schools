            RowBox[{
             RowBox[{
              RowBox[{
              "var", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]",
               "sample", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
             "t", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"rOverDisp", "[", 
             RowBox[{
             "listSamples", "\[LeftDoubleBracket]", "sample", 
              "\[RightDoubleBracket]"}], "]"}]}], "]"}], "]"}], ",", "0"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "listAgeGroups"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"sample", ",", "1", ",", 
         RowBox[{"Length", "[", "listSamples", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "1", ",", 
         RowBox[{
          RowBox[{"Dimensions", "[", "var", "]"}], "\[LeftDoubleBracket]", 
          "3", "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hospitalizationSimulatedLoop", "[", "label_", "]"}], " ", ":=", 
