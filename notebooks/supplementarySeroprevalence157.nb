       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"data2", "===", "Automatic"}], ",", "data", ",", "data2"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"numData1", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{
