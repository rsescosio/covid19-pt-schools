     RowBox[{"NegativeBinomialDistribution", "[", 
      RowBox[{"f", ",", 
       FractionBox["f", 
        RowBox[{"f", "+", "m"}]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hospSimulated", "[", "var_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "var", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]",
             "sample", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "t",
            "\[RightDoubleBracket]"}], ">", "0"}], ",", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{"NBDReparameterized", "[", 
