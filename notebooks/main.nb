      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"contactDataAfter10", "\[LeftDoubleBracket]", 
         RowBox[{"k", ",", "All"}], "\[RightDoubleBracket]"}], "]"}], ",", 
