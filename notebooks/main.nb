      RowBox[{"hospitalizationData", ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tickValues", "=", 
     RowBox[{
      RowBox[{"DateRange", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2020", ",", "3", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2022", ",", "1", ",", "1"}], "}"}], ",", 
