       RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figTotalConmat", " ", "=", " ", 
     RowBox[{"CONTACTMATRIXPLOT", "[", 
      RowBox[{
      "contactDataBefore85", ",", " ", "\"\<ThermometerColors\>\"", " ", ",", 
