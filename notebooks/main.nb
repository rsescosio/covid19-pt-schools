   RowBox[{"Importing", " ", "Data"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"schoolContactsMultiplier", " ", "=", " ", "11.41"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"demographyData85", "=", 
     RowBox[{
      RowBox[{
      "Import", "[", 
       "\"\<../data/Portugal_country_level_age_distribution_85.csv\>\"", 
       "]"}], "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataBefore85", "=", 
     RowBox[{
     "Import", "[", 
      "\"\<../data/Portugal_country_level_M_overall_contact_matrix_85.csv\>\"\
", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"schoolRawContactDataBefore85", "=", "  ", 
     RowBox[{
     "Import", "[", 
      "\"\<../data/Portugal_country_level_F_school_setting_85.csv\>\"", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"schoolContactDataBefore85", " ", "=", " ", 
     RowBox[{
     "schoolContactsMultiplier", " ", "*", " ", 
      "schoolRawContactDataBefore85"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Get", " ", "the", " ", "total", " ", "contacts", " ", "per", " ", 
     "participant"}], " ", "*)"}], 
   RowBox[{
    RowBox[{"calculateContactsAgeGroups2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"contactDataBefore85", "\[LeftDoubleBracket]", 
         RowBox[{"k", ",", "All"}], "\[RightDoubleBracket]"}], "]"}], ",", 
