Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Importing", " ", "estimated", " ", "parameters"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"estimatesData", "=", 
     RowBox[{
     "Import", "[", "\"\<../data/PARAMETER_ESTIMATES.csv\>\"", "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"headerParameters", "=", 
     RowBox[{
     "estimatesData", "\[LeftDoubleBracket]", "1", 
      "\[RightDoubleBracket]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"estimatesData", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"estimatesData", ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Assigning", " ", "parameters"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"probabOfTransmEpsilon", "[", "sample_", "]"}], ":=", 
     RowBox[{"\[Epsilon]", "\[Rule]", 
      RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
       RowBox[{"sample", ",", "1"}], "\[RightDoubleBracket]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"probabOfTransmZeta", "[", "sample_", "]"}], ":=", 
     RowBox[{"\[Zeta]", "\[Rule]", " ", 
      RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
       RowBox[{"sample", ",", "2"}], "\[RightDoubleBracket]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hospitalizationRate", "[", "sample_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\[Nu]", ",", "k"}], "]"}], "\[Rule]", 
        RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
         RowBox[{"sample", ",", 
          RowBox[{"2", "+", "k"}]}], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "numAgeGroups"}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"susceptibility", "[", "sample_", "]"}], ":=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Beta]", ",", "k"}], "]"}], "\[Rule]", 
           RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
            RowBox[{"sample", ",", "14"}], "\[RightDoubleBracket]"}]}], " ", ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Beta]", ",", "k"}], "]"}], "\[Rule]", 
           RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
            RowBox[{"sample", ",", "15"}], "\[RightDoubleBracket]"}]}], " ", ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "4", ",", "7"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Beta]", ",", "k"}], "]"}], "\[Rule]", 
           RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
            RowBox[{"sample", ",", "16"}], "\[RightDoubleBracket]"}]}], " ", ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "8", ",", "10"}], "}"}]}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"latencyRate", "[", "sample_", "]"}], ":=", 
     RowBox[{"\[Alpha]", "\[Rule]", 
      RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
       RowBox[{"sample", ",", "18"}], "\[RightDoubleBracket]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"recoveryRate", "[", "sample_", "]"}], ":=", 
     RowBox[{"\[Gamma]", "\[Rule]", 
      RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
       RowBox[{"sample", ",", "19"}], "\[RightDoubleBracket]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rOverDisp", "[", "sample_", "]"}], ":=", 
     RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
      RowBox[{"sample", ",", "17"}], "\[RightDoubleBracket]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"logFuncParams", "[", "sample_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["xx", "0"], "\[Rule]", " ", 
        RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
         RowBox[{"sample", ",", "20"}], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{
        SubscriptBox["K", "0"], "\[Rule]", " ", 
        RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
         RowBox[{"sample", ",", "21"}], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{
        SubscriptBox["xx", "1"], "\[Rule]", " ", 
        RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
         RowBox[{"sample", ",", "22"}], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{
        SubscriptBox["K", "1"], "\[Rule]", " ", 
        RowBox[{"estimatesData", "\[LeftDoubleBracket]", 
         RowBox[{"sample", ",", "23"}], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{
