     "Import", 
      "[", "\"\<../data/Portugal_country_level_M_overall_contact_matrix_85.\
csv\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"schoolRawContactDataBefore85", "=", "  ", 
     RowBox[{
     "Import", 
      "[", "\"\<../data/Portugal_country_level_F_school_setting_85.csv\>\"", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"schoolContactDataBefore85", " ", "=", " ", 
     RowBox[{
     "schoolContactsMultiplier", " ", "*", " ", 
      "schoolRawContactDataBefore85"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Get", " ", "the", " ", "total", " ", "contacts", " ", "per", " ", 
     "participant"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"calculateTotalContsPerPar", "[", 
      RowBox[{"conmat_", ",", " ", "groupNo_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"conmat", "\[LeftDoubleBracket]", 
         RowBox[{"k", ",", "All"}], "\[RightDoubleBracket]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "groupNo"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"calculateContactsAgeGroups2", "=", 
     RowBox[{"calculateTotalContsPerPar", "[", 
      RowBox[{"contactDataBefore85", ",", " ", "85"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"calculateSchoolContactsAgeGroups2", "=", 
     RowBox[{"calculateTotalContsPerPar", "[", 
      RowBox[{"schoolContactDataBefore85", ",", " ", "85"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Plotting", " ", "*)"}], 
   RowBox[{
    RowBox[{"figTotalContPerAge", " ", "=", " ", 
     RowBox[{"plotThickLine", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "calculateContactsAgeGroups2", ",", " ", 
