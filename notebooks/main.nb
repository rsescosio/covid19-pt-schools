Cell[CellGroupData[{

Cell["TRANSFORMING THE CONTACT MATRICES FROM 86x86 TO 10x10", "Subsection",
 CellChangeTimes->{{3.948906733953905*^9, 3.9489067547556868`*^9}, {
   3.948906797784504*^9, 3.948906803291382*^9}, 
   3.948907186689744*^9},ExpressionUUID->"9bbc5ca7-ee45-4e5a-90c4-\
91fe9f907115"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Demographic", " ", "data", " ", "for", " ", "86"}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"www", ".", "pordata", ".", "pt"}], "/", "Portugal"}], "/", 
       "Popula"}], "%", "C3", "%", "A7", "%", "C3", "%", "A3o"}], "+", 
     RowBox[{
      RowBox[{"residente", "++"}], "m", "%", "C3", "%", "A9dia"}], "+", 
     "anual", "+", "total", "+", "e", "+", "por", "+", "grupo", "+", 
     RowBox[{"et", "%", "C3", "%", "A1rio"}], "-", "10"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"demog86Plus", " ", "=", " ", "316442"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Getting", " ", "the", " ", "ratio", " ", "of", " ", "lockdown", " ", 
     "contacts", " ", "based", " ", "on", " ", "NL", " ", "data"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataNLBefore10", "=", 
     RowBox[{
     "Import", "[", "\"\<../data/CONTACT MATRIX NL BEFORE 10.csv\>\"", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataNLAfter10", "=", 
     RowBox[{
     "Import", "[", "\"\<../data/CONTACT MATRIX NL AFTER 10.csv\>\"", "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactRatioNL10", "=", 
     RowBox[{"contactDataNLAfter10", "/", "contactDataNLBefore10"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Function", " ", "transforming", " ", "the", " ", "1", "x86", " ", "age", 
     " ", "groups", " ", "to", " ", "1", "x10"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"transformList86to10", "[", "list85_", "]"}], ":=", 
     RowBox[{"Total", "/@", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"list85", ",", "5"}], "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ";;", "2"}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"list85", ",", "10"}], "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"2", ";;"}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{"{", 
         RowBox[{"list85", "\[LeftDoubleBracket]", 
          RowBox[{"81", ";;"}], "\[RightDoubleBracket]"}], "}"}]}], "]"}]}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"demographyData86", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"demographyData85", ",", " ", "demog86Plus"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"demographyData10", "=", 
     RowBox[{"transformList86to10", "[", "demographyData86", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Creating", " ", "the", " ", "86", "x86", " ", "contact", " ", 
     "matrices"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"transformMatrix85to86", "[", "mat85_", "]"}], ":=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"mat85", ",", 
         RowBox[{"{", 
          RowBox[{
          "mat85", "\[LeftDoubleBracket]", "85", "\[RightDoubleBracket]"}], 
          "}"}]}], "]"}], ",", 
       RowBox[{"List", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"mat85", ",", 
             RowBox[{"{", 
              RowBox[{
              "mat85", "\[LeftDoubleBracket]", "85", 
               "\[RightDoubleBracket]"}], "}"}]}], "]"}], 
           "\[LeftDoubleBracket]", 
           RowBox[{"All", ",", "85"}], "\[RightDoubleBracket]"}], " ", 
          RowBox[{
           RowBox[{
           "demographyData86", "\[LeftDoubleBracket]", "86", 
            "\[RightDoubleBracket]"}], "/", 
           RowBox[{
           "demographyData86", "\[LeftDoubleBracket]", "85", 
            "\[RightDoubleBracket]"}]}]}], ")"}]}], ",", " ", "2"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataBefore86", "=", 
     RowBox[{"transformMatrix85to86", "[", "contactDataBefore85", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"schoolContactDataBefore86", "=", 
     RowBox[{
     "transformMatrix85to86", "[", "schoolContactDataBefore85", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Creating", " ", "the", " ", "10", "x10", " ", "contact", " ", 
     "matrices"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataBefore10", "=", 
     RowBox[{
      RowBox[{"transformList86to10", "[", " ", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"transformList86to10", "[", 
          RowBox[{"Transpose", "[", "contactDataBefore86", "]"}], "]"}], 
         "]"}], " ", "demographyData86"}], "]"}], "/", "demographyData10"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataAfter10", "=", 
     RowBox[{"contactDataBefore10", " ", "*", " ", "contactRatioNL10"}]}], 
    " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"schoolContactDataBefore10", "=", 
     RowBox[{
      RowBox[{"transformList86to10", "[", " ", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"transformList86to10", "[", 
          RowBox[{"Transpose", "[", "schoolContactDataBefore86", "]"}], "]"}],
          "]"}], " ", "demographyData86"}], "]"}], "/", 
      "demographyData10"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Exporting", " ", "data"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"exportData", ",", "\[IndentingNewLine]", 
