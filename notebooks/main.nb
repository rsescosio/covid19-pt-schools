Cell[CellGroupData[{

Cell["SCHOOL REDUCTION FACTOR", "Subsection",
 CellChangeTimes->{{3.948979199565186*^9, 
  3.948979211137052*^9}},ExpressionUUID->"03df2b68-96d6-4e7b-bf5f-\
478c80be744e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Calculation", " ", "of", " ", "the", " ", "zeta_school", " ", "parameter",
     " ", "for", " ", "Scenario", " ", "2"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "schoolReductionEquation", " ", ":=", " ", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", "==", "9"}], " ", "||", " ", 
            RowBox[{"k", "==", "10"}], " ", "||", 
            RowBox[{"l", "==", "9"}], "||", 
            RowBox[{"l", "==", "10"}], "||", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"l", "==", "3"}], " ", "&&", " ", 
              RowBox[{"k", "==", "1"}]}], ")"}], "||", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"l", "==", "1"}], " ", "&&", " ", 
              RowBox[{"k", "==", "3"}]}], ")"}]}], ")"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["u", "2"], " ", 
                  RowBox[{"Subscript", "[", 
                   RowBox[{"b", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
                    SubscriptBox["u", "2"]}], ")"}], "\[Zeta]", " ", 
                  RowBox[{"Subscript", "[", 
                   RowBox[{"a", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}]}], ")"}], "-", 
               RowBox[{"reductionFactor", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"s", ",", 
                  RowBox[{"{", 
                   RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}]}], "==", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SubscriptBox["u", "1"], " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"b", ",", 
                   RowBox[{"{", 
                    RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   SubscriptBox["u", "1"]}], ")"}], "\[Zeta]", " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"a", ",", 
                   RowBox[{"{", 
                    RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}]}], ")"}]}], ",",
              "reductionFactor"}], "]"}], "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "numAgeGroups"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "1", ",", "numAgeGroups"}], "}"}]}], "]"}]}], ";"}],
