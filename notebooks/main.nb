       RowBox[{"{", 
        RowBox[{
         RowBox[{"colorDarkRainbow", "[", 
          RowBox[{"[", "11", "]"}], "]"}], ",", " ", 
         RowBox[{"colorDarkRainbow", "[", 
          RowBox[{"[", "5", "]"}], "]"}]}], "}"}], ",", "\"\<\>\"", ",", 
       "\"\<Age (years)\>\"", ",", "\"\<Contact rate (1/day)\>\"", ",", 
