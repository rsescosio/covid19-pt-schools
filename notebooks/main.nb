Cell[CellGroupData[{

Cell["CONTACT MATRICES FROM VESPIGNANI ET AL.", "Subsection",
 CellChangeTimes->{{3.9489067660044193`*^9, 3.9489067780370913`*^9}, 
   3.948906861255418*^9},ExpressionUUID->"a3abc247-d780-4185-b77d-\
15ac6cc803d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Importing", " ", "Data"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"https", ":"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{"github", ".", "com"}], "/", "mobs"}], "-", 
     RowBox[{"lab", "/", "mixing"}], "-", "patterns"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"schoolContactsMultiplier", " ", "=", " ", "11.41"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"demographyData85", "=", 
     RowBox[{
      RowBox[{
      "Import", "[", "\"\<../data/PT_DEMOGRAPHY_DATA_85.csv\>\"", "]"}], "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataBefore85", "=", 
     RowBox[{
     "Import", "[", "\"\<../data/PT_CONTACT_MATRIX_TOTAL_85.csv\>\"", "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"schoolRawContactDataBefore85", "=", "  ", 
     RowBox[{
     "Import", "[", "\"\<../data/PT_CONTACT_MATRIX_SCHOOL_85.csv\>\"", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"schoolContactDataBefore85", " ", "=", " ", 
     RowBox[{
     "schoolContactsMultiplier", " ", "*", " ", 
      "schoolRawContactDataBefore85"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Get", " ", "the", " ", "total", " ", "contacts", " ", "per", " ", 
     "participant"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"calculateTotalContsPerPar", "[", 
      RowBox[{"conmat_", ",", " ", "groupNo_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"conmat", "\[LeftDoubleBracket]", 
         RowBox[{"k", ",", "All"}], "\[RightDoubleBracket]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "groupNo"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"calculateContactsAgeGroups2", "=", 
     RowBox[{"calculateTotalContsPerPar", "[", 
      RowBox[{"contactDataBefore85", ",", " ", "85"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"calculateSchoolContactsAgeGroups2", "=", 
     RowBox[{"calculateTotalContsPerPar", "[", 
      RowBox[{"schoolContactDataBefore85", ",", " ", "85"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Plotting", " ", "*)"}], 
   RowBox[{
    RowBox[{"figTotalContPerAge", " ", "=", " ", 
     RowBox[{"plotThickLine", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "calculateContactsAgeGroups2", ",", " ", 
         "calculateSchoolContactsAgeGroups2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"colorDarkRed", ",", " ", "colorDarkGreen"}], "}"}], 
       ",", "\"\<\>\"", ",", "\"\<Age (years)\>\"", 
       ",", "\"\<Contact rate (1/day)\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<total\>\"", ",", " ", "\"\<schools\>\""}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figTotalConmat", " ", "=", " ", 
     RowBox[{"plotMatrix", "[", 
      RowBox[{
      "contactDataBefore85", ",", " ", "\"\<ThermometerColors\>\"", " ", 
       ",", "\"\<Baseline, total\>\"", ",", " ", "\"\<contact\>\""}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figSchoolConmat", " ", "=", " ", 
     RowBox[{"plotMatrix", "[", 
      RowBox[{"schoolContactDataBefore85", ",", " ", 
       RowBox[{"ColorData", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<AlpineColors\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1.15", ",", "0.45"}], "}"}]}], "}"}], "]"}], ",", 
       " ", "\"\<Baseline, school\>\"", ",", " ", "\"\<contact\>\""}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figA", " ", "=", " ", 
     RowBox[{"plotWithLetter", "[", 
      RowBox[{
      "figTotalConmat", ",", " ", "\"\<A\>\"", ",", " ", "\"\<right\>\""}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figB", " ", "=", " ", 
     RowBox[{"plotWithLetter", "[", 
      RowBox[{
      "figSchoolConmat", ",", " ", "\"\<B\>\"", ",", " ", "\"\<right\>\""}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figC", " ", "=", " ", 
     RowBox[{"plotWithLetter", "[", 
      RowBox[{
      "figTotalContPerAge", ",", " ", "\"\<C\>\"", ",", 
       " ", "\"\<right\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figConts", " ", "=", " ", 
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"figA", ",", "SpanFromLeft", ",", " ", "figB"}], "}"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"SpanFromLeft", ",", " ", "figC", ",", " ", "SpanFromLeft"}],
          "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{"ifShowFigs", ",", " ", "figConts"}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.948881134834469*^9, 3.948881175346958*^9}, 
