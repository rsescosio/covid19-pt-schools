Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Importing", " ", "data"}], " ", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"hospitalizationData", "=", 
     RowBox[{
     "Import", "[", "\"\<../data/PT_HOSPITALIZATION_DATA.csv\>\"", "]"}]}], 
