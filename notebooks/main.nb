       RowBox[{"{", 
        RowBox[{"colorDarkRed", ",", " ", "colorDarkGreen"}], "}"}], 
       ",", "\"\<\>\"", ",", "\"\<Age (years)\>\"", 
       ",", "\"\<Contact rate (1/day)\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<total\>\"", ",", " ", "\"\<schools\>\""}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figTotalConmat", " ", "=", " ", 
     RowBox[{"plotMatrix", "[", 
