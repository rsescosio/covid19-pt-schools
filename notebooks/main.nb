Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Calculation", " ", "of", " ", "the", " ", "zeta_school", " ", "parameter",
     " ", "for", " ", "Scenario", " ", "2"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "schoolReductionEquation", " ", ":=", " ", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", "==", "9"}], " ", "||", " ", 
            RowBox[{"k", "==", "10"}], " ", "||", 
            RowBox[{"l", "==", "9"}], "||", 
            RowBox[{"l", "==", "10"}], "||", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"l", "==", "3"}], " ", "&&", " ", 
              RowBox[{"k", "==", "1"}]}], ")"}], "||", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"l", "==", "1"}], " ", "&&", " ", 
              RowBox[{"k", "==", "3"}]}], ")"}]}], ")"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["u", "2"], " ", 
                  RowBox[{"Subscript", "[", 
                   RowBox[{"b", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
                    SubscriptBox["u", "2"]}], ")"}], "\[Zeta]", " ", 
                  RowBox[{"Subscript", "[", 
                   RowBox[{"a", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}]}], ")"}], "-", 
               RowBox[{"reductionFactor", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"s", ",", 
                  RowBox[{"{", 
                   RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}]}], "==", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SubscriptBox["u", "1"], " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"b", ",", 
                   RowBox[{"{", 
                    RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   SubscriptBox["u", "1"]}], ")"}], "\[Zeta]", " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"a", ",", 
                   RowBox[{"{", 
                    RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}]}], ")"}]}], ",",
              "reductionFactor"}], "]"}], "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "numAgeGroups"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "1", ",", "numAgeGroups"}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"schoolReductionFactor", "[", "sample_", "]"}], ":=", 
     RowBox[{"zetaSchools", "->", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"schoolReductionEquation", " ", "/.", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"contactRates", ",", 
            RowBox[{"probabOfTransmZeta", "[", "sample", "]"}], ",", 
            RowBox[{"uParams", "[", "sample", "]"}]}], "}"}], "]"}]}], "]"}], 
       "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Table", " ", "for", " ", "all", " ", "parameters"}], " ", "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"parametersComplete", "[", "sample_", "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"parameters", "[", "sample", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"schoolReductionFactor", "[", "sample", "]"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SRFFilePath", " ", "=", " ", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{
       RowBox[{"{", "\"\<../results\>\"", "}"}], ",", 
       RowBox[{
       "StringJoin", "[", "\"\<SCHOOL_REDUCTION_FACTOR.wxf\>\"", "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"schRedFacObtained", "=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "SRF", "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", "SRFFilePath", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"SRF", " ", "=", " ", 
          RowBox[{"Import", "[", 
           RowBox[{"SRFFilePath", ",", "\"\<WXF\>\""}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"SRF", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"schoolReductionEquation", " ", "/.", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"{", 
                  RowBox[{"contactRates", ",", 
                   RowBox[{"probabOfTransmZeta", "[", "sample", "]"}], ",", 
                   RowBox[{"uParams", "[", "sample", "]"}]}], "}"}], "]"}]}], 
               "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"sample", ",", " ", "1", ",", " ", "numSamples"}], 
              "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{"SRFFilePath", ",", "SRF", ",", "\"\<WXF\>\"", ",", 
            RowBox[{"\"\<CompressionLevel\>\"", "->", "5"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "SRF"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Remove", "[", "\"\<plottingFunctions`*\>\"", "]"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Get", "[", "\"\<../packages/plottingFunctions.m\>\"", "]"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"plotHistogram", "[", 
    RowBox[{
    "schRedFacObtained", ",", " ", "\"\<School reduction factor\>\"", ",", 
     " ", "\"\<\\!\\(\\*SubscriptBox[\\(\[Zeta]\\), \\(s\\)]\\)\>\"", ",", 
     " ", "\"\<probability\>\""}], "]"}]}]}]], "Input",
