     RowBox[{"lab", "/", "mixing"}], "-", "patterns"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"schoolContactsMultiplier", " ", "=", " ", "11.41"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"demographyData85", "=", 
     RowBox[{
      RowBox[{
      "Import", 
       "[", "\"\<../data/Portugal_country_level_age_distribution_85.csv\>\"", 
       "]"}], "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataBefore85", "=", 
