     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Get", " ", "the", " ", "total", " ", "contacts", " ", "per", " ", 
     "participant"}], " ", "*)"}], 
   RowBox[{
    RowBox[{"calculateContactsAgeGroupsBefore", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"contactDataBefore10", "\[LeftDoubleBracket]", 
         RowBox[{"k", ",", "All"}], "\[RightDoubleBracket]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "ageGroups"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"calculateContactsAgeGroupsAfter", "=", 
