         RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ticks", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"Rotate", "[", 
          RowBox[{
           RowBox[{"DateString", "[", 
            RowBox[{
             RowBox[{"DateObject", "[", "#", "]"}], ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<MonthNameShort\>\"", ",", "\"\< \>\"", 
               ",", "\"\<Year\>\""}], "}"}]}], "]"}], ",", 
           RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], "}"}], "&"}], "/@", 
      "tickValues"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"transitionDates", "=", 
