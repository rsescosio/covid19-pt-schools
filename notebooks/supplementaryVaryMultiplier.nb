Cell[TextData[StyleBox["Transforming the contact matrices from 86x86 to 10x10",
 FontFamily->"Helvetica Neue",
 FontColor->RGBColor[
  0.9513237201495384, 0.3727321278706035, 0.2055237659266041]]], "Subsection",\

 CellChangeTimes->{{3.948906733953905*^9, 3.9489067547556868`*^9}, {
   3.948906797784504*^9, 3.948906803291382*^9}, 3.948907186689744*^9, {
   3.953035124155424*^9, 3.953035140589038*^9}},
 CellTags->"c:9",ExpressionUUID->"9bbc5ca7-ee45-4e5a-90c4-91fe9f907115"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Demographic", " ", "data", " ", "for", " ", "86"}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"www", ".", "pordata", ".", "pt"}], "/", "Portugal"}], "/", 
       "Popula"}], "%", "C3", "%", "A7", "%", "C3", "%", "A3o"}], "+", 
     RowBox[{
      RowBox[{"residente", "++"}], "m", "%", "C3", "%", "A9dia"}], "+", 
     "anual", "+", "total", "+", "e", "+", "por", "+", "grupo", "+", 
     RowBox[{"et", "%", "C3", "%", "A1rio"}], "-", "10"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"demog86Plus", " ", "=", " ", "316442"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Getting", " ", "the", " ", "ratio", " ", "of", " ", "lockdown", " ", 
     "contacts", " ", "based", " ", "on", " ", "NL", " ", "data"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataNLBefore10", "=", 
     RowBox[{
     "Import", "[", "\"\<../data/NL_CONTACT_MATRIX_BEFORE_10.csv\>\"", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactDataNLAfter10", "=", 
     RowBox[{
     "Import", "[", "\"\<../data/NL_CONTACT_MATRIX_AFTER_10.csv\>\"", "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contactRatioNL10", "=", 
     RowBox[{"contactDataNLAfter10", "/", "contactDataNLBefore10"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"demographyData10", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
      "Import", "[", "\"\<../data/PT_DEMOGRAPHY_DATA_10.xlsx\>\"", "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Function", " ", "transforming", " ", "the", " ", "1", "x86", " ", "age", 
     " ", "groups", " ", "to", " ", "1", "x10"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"transformList86to10", "[", "list85_", "]"}], ":=", 
     RowBox[{"Total", "/@", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"list85", ",", "5"}], "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ";;", "2"}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"list85", ",", "10"}], "]"}], "\[LeftDoubleBracket]", 
