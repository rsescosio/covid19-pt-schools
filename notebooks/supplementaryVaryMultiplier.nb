Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "next", " ", "generation", " ", "matrix", " ", "for", " ", 
    "each", " ", "scenario"}], " ", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"NGM", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"eqsList", "[", 
                 RowBox[{"scenarios", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], "\[LeftDoubleBracket]", 
                RowBox[{"p", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "varsList", "\[LeftDoubleBracket]", "p", 
                "\[RightDoubleBracket]"}]}], "]"}]}], " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"eqsList", "[", 
                RowBox[{"scenarios", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "\[LeftDoubleBracket]", 
               RowBox[{"k", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{
              "varsList", "\[LeftDoubleBracket]", "p", 
               "\[RightDoubleBracket]"}]}], "]"}]}], ")"}], ")"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "eqNumbersExposed"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "eqNumbersInfectious"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", 
         RowBox[{"Length", "[", "scenarios", "]"}]}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Substituting", " ", "values", " ", "to", " ", "the", " ", "next", " ", 
     "generation", " ", "matrices"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"substituteNGM", "[", 
      RowBox[{"scenNum_", ",", " ", "sample_", ",", " ", "time_"}], "]"}], 
     " ", ":=", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"NGM", "[", 
           RowBox[{"[", "scenNum", "]"}], "]"}], "/.", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"First", "@", 
             RowBox[{
              RowBox[{"solutionsScenarios", "[", 
               RowBox[{"[", "scenNum", "]"}], "]"}], "[", 
              RowBox[{"[", "sample", "]"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", "eqNumbersSusceptible", "]"}], "]"}]}], ")"}], " ", "/.",
         " ", 
        RowBox[{"parametersCompleteSampled", "[", 
         RowBox[{"[", "sample", "]"}], "]"}]}], ")"}], " ", "/.", " ", 
      RowBox[{"t", " ", "->", " ", "time"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"NGMForLoop", "[", "i_", "]"}], " ", ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"substituteNGM", "[", 
          RowBox[{"i", ",", " ", "j", ",", " ", 
           RowBox[{"timeSpecificIndices", "[", 
            RowBox[{"[", "tIdx", "]"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"tIdx", ",", "1", ",", 
           RowBox[{"Length", "[", "timeSpecificIndices", "]"}]}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", "listSamples", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NGMScenarios", " ", "=", " ", 
     RowBox[{"importExportScenarioResults", "[", 
      RowBox[{"\"\<NGM_DISCRETE\>\"", ",", " ", "NGMForLoop", ",", 
       " ", "\"\<analysis/multiplier\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.949138008164383*^9, 3.949138165851074*^9}, {
