# Calculate median and 95% credible intervals for each time point
median_incidence <- apply(all_simulated_incidences, 1, median, na.rm = TRUE)
# Calculate median and 95% credible intervals for each time point
median_incidence <- apply(all_simulated_incidences, 1, median, na.rm = TRUE)
# Calculate median and 95% credible intervals for each time point
median_incidence <- apply(all_simulated_incidences, 1, median, na.rm = TRUE)
lower_ci_incidence <- apply(all_simulated_incidences, 1, quantile, probs = 0.025, na.rm = TRUE)
upper_ci_incidence <- apply(all_simulated_incidences, 1, quantile, probs = 0.975, na.rm = TRUE)
# Create a dataframe for the fit
fit_df <- data.frame(
time = time_points,
median_incidence = median_incidence,
lower_ci = lower_ci_incidence,
upper_ci = upper_ci_incidence
)
# Plotting the fit
p_fit <- ggplot() +
# 95% Credible Interval (ribbon)
geom_ribbon(data = fit_df, aes(x = time, ymin = lower_ci, ymax = upper_ci, fill = "95% Credible Interval"),
alpha = 0.5) +
# Median Fit Line
geom_line(data = fit_df, aes(x = time, y = median_incidence, color = "Median Fit"),
linewidth = 1, linetype = "solid") +
# Observed Data Points
geom_point(data = observed_data_df, aes(x = time, y = incidence, color = "Observed Data"),
size = 1.5, alpha = 0.7) +
labs(title = "Model Fit to Observed Incidence Data",
x = "Time (days)",
y = "Daily Incidence") +
# Manually define colors and fills for the legend
scale_color_manual(name = "Data/Fit",
values = c("Median Fit" = "darkred", "Observed Data" = "blue")) +
scale_fill_manual(name = "Interval",
values = c("95% Credible Interval" = "grey")) +
# Combine legends if desired (optional)
guides(color = guide_legend(order = 1), fill = guide_legend(order = 2)) +
theme_minimal() +
theme(legend.position = "bottom")
print(p_fit)
} else {
