# --- 5. Analyze Results ---
if (length(accepted_params_list) > 0) {
accepted_params_df <- do.call(rbind, accepted_params_list) %>% as.data.frame()
cat("\nNumber of accepted samples:", nrow(accepted_params_df), "\n")
# Print means and standard deviations
cat("\nMeans and Standard Deviations of Accepted Parameters:\n")
for (param_name in names(prior_ranges)) {
if (!param_name %in% colnames(accepted_params_df)) next
mean_val <- mean(accepted_params_df[[param_name]])
sd_val <- sd(accepted_params_df[[param_name]])
true_val <- NA
if (param_name %in% names(true_params_for_obs_gen)) {
true_val <- true_params_for_obs_gen[param_name]
}
cat(sprintf("  %s: Mean=%.4f (True=%.4f), StdDev=%.4f\n", param_name, mean_val, true_val, sd_val))
}
# Plot marginal posterior distributions for all estimated parameters
plot_list <- list()
for (param_name in names(prior_ranges)) {
p <- ggplot(accepted_params_df, aes_string(x = param_name)) +
geom_histogram(aes(y = ..density..), bins = 30, fill = "skyblue", color = "black") +
geom_density(color = "blue", size = 1) +
{ if (param_name %in% names(true_params_for_obs_gen)) {
geom_vline(xintercept = true_params_for_obs_gen[param_name], color = "red", linetype = "dashed", size = 1)
}
} +
labs(title = paste("Posterior of", param_name), x = param_name, y = "Density") +
theme_minimal()
plot_list[[param_name]] <- p
}
plot_grid(plotlist = plot_list, ncol = 3)
# Posterior Predictive Check (simulate with accepted parameters and plot against observed)
# Ensure there are samples *before* trying to set num_traces_to_plot
if (nrow(accepted_params_df) > 0) { # <--- ADDED THIS CHECK
num_traces_to_plot <- min(10, nrow(accepted_params_df))
# Initialize matrices *only if* num_traces_to_plot > 0
if (num_traces_to_plot > 0) { # <--- ADDED THIS CHECK
simulated_I_traces <- matrix(NA, nrow = length(time_points_obs), ncol = num_traces_to_plot)
simulated_H_traces <- matrix(NA, nrow = length(time_points_obs), ncol = num_traces_to_plot)
cat("\nPerforming Posterior Predictive Check (simulating ", num_traces_to_plot, " traces)...\n")
for (j in 1:num_traces_to_plot) {
params_for_sim_estimated <- as.numeric(accepted_params_df[random_indices[j], names(prior_ranges)])
names(params_for_sim_estimated) <- names(prior_ranges)
current_model_parms_sim <- c(params_for_sim_estimated, fixed_params_for_abc, fixed_params_for_model)
sim_result_ppc <- ode(
y = initial_state_deSolve,
times = time_points_obs,
func = seihr_age_model,
parms = current_model_parms_sim
)
sim_I_cols <- grep("I_Age", colnames(sim_result_ppc))
sim_H_cols <- grep("H_Age", colnames(sim_result_ppc))
simulated_I_traces[, j] <- rowSums(sim_result_ppc[, sim_I_cols, drop = FALSE])
simulated_H_traces[, j] <- rowSums(sim_result_ppc[, sim_H_cols, drop = FALSE])
}
sim_I_df <- melt(simulated_I_traces)
sim_I_df$time <- rep(time_points_obs, num_traces_to_plot)
names(sim_I_df) <- c("Var1", "trace", "value", "time")
sim_H_df <- melt(simulated_H_traces)
sim_H_df$time <- rep(time_points_obs, num_traces_to_plot)
names(sim_H_df) <- c("Var1", "trace", "value", "time")
ppc_p1 <- ggplot() +
geom_line(data = sim_I_df, aes(x = time, y = value, group = trace), color = "gray", alpha = 0.6) +
geom_line(data = observed_data_df, aes(x = time, y = total_I), color = "blue", size = 1.2, linetype = "solid") +
labs(title = "PPC: Total Infected", x = "Time (days)", y = "Count") +
theme_minimal()
ppc_p2 <- ggplot() +
geom_line(data = sim_H_df, aes(x = time, y = value, group = trace), color = "gray", alpha = 0.6) +
geom_line(data = observed_data_df, aes(x = time, y = total_H), color = "red", size = 1.2, linetype = "solid") +
labs(title = "PPC: Total Hospitalized", x = "Time (days)", y = "Count") +
theme_minimal()
plot_grid(ppc_p1, ppc_p2, ncol = 2)
} else {
cat("Not enough accepted samples to perform Posterior Predictive Check (num_traces_to_plot was 0).\n")
}
} else {
cat("No accepted samples available for Posterior Predictive Check.\n")
}
dist_df <- data.frame(distance = all_distances)
p_dist <- ggplot(dist_df, aes(x = distance)) +
geom_histogram(bins = 50, fill = "lightcoral", color = "black", aes(y = ..density..)) +
geom_vline(xintercept = tolerance, color = "blue", linetype = "dashed", size = 1) +
labs(title = "Distribution of All Simulated Distances", x = "Distance", y = "Density") +
theme_minimal()
print(p_dist)
} else {
cat("\nNo samples accepted. Consider increasing num_iterations or tolerance, or adjusting prior ranges.\n")
}
